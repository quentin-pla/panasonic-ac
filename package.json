{
    "name": "panasonic-comfort-cloud-api",
    "version": "1.4.0",
    "description": "Client for Panasonic Comfort Cloud API to control air conditioners",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "type": "module",
    "scripts": {
        "start": "node dist/index.js",
        "watch:dev": "npm run fix-imports && dotenv -e .env.development -- tsc-watch --onSuccess \"node dist/index.js\"",
        "build": "npm run fix-imports && tsc",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "tslint -p tsconfig.json",
        "prepare": "tsc",
        "fix-imports": "node fix-imports.js"
    },
    "devDependencies": {
        "@types/node": "^18.13.0",
        "dotenv": "^16.3.1",
        "dotenv-cli": "^8.0.0",
        "prettier": "^3.0.3",
        "ts-node": "^10.9.2",
        "tsc-watch": "^6.2.1",
        "tslint": "^6.1.3",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "panasonic-comfort-cloud-client": "^2.1.5"
    }
}